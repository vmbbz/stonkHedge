# Binance Web3 API credentials are server-only. Never prefix these with VITE_.
# Create .env.local from this file and keep the real values out of Git and chat.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional server-side tuning. The official base URL already includes /build.
BINANCE_WEB3_BASE_URL=https://web3.binance.com/build
BINANCE_WEB3_TIMEOUT_MS=8000
